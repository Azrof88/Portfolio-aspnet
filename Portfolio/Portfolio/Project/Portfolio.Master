<%@ Master Language="C#" AutoEventWireup="true" CodeFile="~/Project/Portfolio.Master.cs" Inherits="Portfolio.Project.PortfolioMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>H.M. Azrof | Portfolio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Bootstrap CSS from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts (Poppins) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="timeline.css" rel="stylesheet" />

    <!-- Your New Custom Stylesheet (we will create this next) -->
    <link href="style.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- ====================================================== -->
        <!-- =========== 1. ADD THE BACKGROUND CONTAINER ========== -->
        <!-- ====================================================== -->
        <div id="vanta-bg"></div>
        <!-- ====================================================== -->

        
        <!-- ======================= NAVIGATION BAR ======================= -->
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold" href="#">H.M. AZROF</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Inside Portfolio.Master -->

<ul class="navbar-nav ms-auto">
    <!-- This link now points to the main page -->
    <li class="nav-item"><a class="nav-link" href="HomePage.aspx">Home</a></li>
    
    <!-- These links now point to the main page AND the section -->
    <li class="nav-item"><a class="nav-link" href="HomePage.aspx#about">About</a></li>
    <li class="nav-item"><a class="nav-link" href="HomePage.aspx#skills">Skills</a></li>
    <li class="nav-item"><a class="nav-link" href="HomePage.aspx#experience">My Journey</a></li>
    <li class="nav-item"><a class="nav-link" href="HomePage.aspx#projects">Projects</a></li>
    <li class="nav-item"><a class="nav-link" href="HomePage.aspx#testimonials">Testimonials</a></li>
    
    <!-- This link correctly points to the blog page -->
    <li class="nav-item"><a class="nav-link" href="Blog.aspx">Blog</a></li>

    <li class="nav-item"><a class="nav-link" href="HomePage.aspx#contact">Contact</a></li>
</ul>
                </div>
            </div>
        </nav>

        <!-- ======================= MAIN CONTENT AREA ======================= -->
        <div>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
                <!-- The content from your HomePage.aspx will be injected here -->
            </asp:ContentPlaceHolder>
        </div>

        <!-- ======================= FOOTER ======================= -->
        <footer class="footer text-center py-4">
            <div class="container">
                <div class="social-icons mb-2">
                    <a href="https://github.com/Azrof88" class="social-icon" target="_blank" rel="noopener"><i class="bi bi-github"></i></a>
                    <a href="https://www.linkedin.com/in/h-m-azrof-468839253/" class="social-icon" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i></a>
                </div>
                <p class="mb-0 small">&copy; <%= DateTime.Now.Year %> H.M. Azrof. All Rights Reserved.</p>
            </div>
        </footer>

        <!-- Bootstrap JS Bundle from CDN -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="animations.js"></script>

        <!-- ====================================================== -->
        <!-- =========== 2. ADD VANTA.JS SCRIPT FILES ============= -->
        <!-- ====================================================== -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.birds.min.js"></script>
        <!-- ====================================================== -->

        <!-- ====================================================== -->
        <!-- ========= 3. INITIALIZE THE VANTA ANIMATION ========== -->
        <!-- ====================================================== -->
        <script>
            // This runs the VANTA.NET effect
            VANTA.BIRDS({
                el: "#vanta-bg",    // Targets the div we created
                mouseControls: true,
                touchControls: true,
                gyroControls: false,
                minHeight: 200.00,
                minWidth: 200.00,
                scale: 1.00,
                scaleMobile: 1.00,
                color: 0x7b2cbf, // Your portfolio's accent purple
                backgroundColor: 0x0f0c29, // Your portfolio's dark base color
                points: 10.00,
                maxDistance: 25.00,
                spacing: 18.00
            });
        </script>
        <!-- ====================================================== -->

       
    </form>
</body>
</html>

