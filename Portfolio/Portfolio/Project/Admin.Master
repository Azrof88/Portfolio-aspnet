<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" CodeFile="~/Project/Admin.Master.cs" Inherits="Portfolio.Project.AdminMaster" %>


<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title>Admin Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <link href="admin-layout.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div id="pageWrapper" class="page-wrapper" runat="server">
            <aside id="sidebar" class="sidebar">
                <div class="sidebar-header">
                    <a href="Admin.aspx" class="sidebar-brand">Admin Panel</a>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="#projects" class="sidebar-link active"><i class="bi bi-kanban-fill me-2"></i> Projects</a></li>
                    <li><a href="#testimonials" class="sidebar-link"><i class="bi bi-chat-square-quote-fill me-2"></i> Testimonials</a></li>
                    <li><a href="#blog" class="sidebar-link"><i class="bi bi-file-post-fill me-2"></i> Blog</a></li>
                    <li><a href="#journey" class="sidebar-link"><i class="bi bi-signpost-split-fill me-2"></i> Journey</a></li>
                    <li><a href="#skills" class="sidebar-link"><i class="bi bi-tools me-2"></i> Skills</a></li>
                    <!-- Add this line with the other sidebar links -->
<li><a href="#messages" class="sidebar-link"><i class="bi bi-envelope-fill me-2"></i> Messages</a></li>
                    </ul>
            </aside>

            <div class="main-content">
                <nav class="navbar navbar-expand navbar-light bg-white top-navbar">
                    <button id="sidebar-toggle" class="btn border-0" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <asp:LinkButton ID="lnkLogout" runat="server" OnClick="lnkLogout_Click" CssClass="nav-link">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </nav>

                <main class="container-fluid p-4">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // Sidebar toggle for mobile
                const sidebarToggle = document.querySelector("#sidebar-toggle");
                if (sidebarToggle) {
                    sidebarToggle.addEventListener("click", function () {
                        document.querySelector(".page-wrapper").classList.toggle("sidebar-collapsed");
                    });
                }

                // Active link highlighting on scroll (Scroll-Spy)
                const sections = document.querySelectorAll('h2[id]');
                const navLinks = document.querySelectorAll('.sidebar-link');

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            navLinks.forEach(link => {
                                link.classList.remove('active');
                                if (link.getAttribute('href').substring(1) === entry.target.id) {
                                    link.classList.add('active');
                                }
                            });
                        }
                    });
                }, { rootMargin: "-50% 0px -50% 0px" });

                sections.forEach(sec => observer.observe(sec));
            });
        </script>
    </form>
</body>
</html>